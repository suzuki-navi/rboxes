#!/usr/bin/perl
use strict;
use warnings;
use File::Find;
use File::Basename;
use Cwd 'abs_path';

# Global data structures
my %dir_data;
my $target_dir;
my $original_target_dir;  # Store original path format (relative or absolute)
my $threshold_percent = 25;
my $respect_gitignore = 1;  # Default: respect .gitignore
my %gitignore_cache;  # Cache for parsed .gitignore files
my $max_entries = 10;     # Maximum entries to display (0 = all)
my $max_extensions = 10;  # Maximum extensions to display (0 = all)

# Parse arguments
sub show_help {
    print <<'EOF';
Usage: summarize-directory-size [OPTIONS] [DIRECTORY]

Summarizes directory sizes with recursive breakdown of large subdirectories.

Options:
    --threshold-percent N  Size threshold percentage for expanding subdirectories (default: 25)
    --max-entries N        Maximum number of entries to display per directory (default: 10, 0 = all)
    --max-extensions N     Maximum number of extensions to display per directory (default: 10, 0 = all)
    --include-gitignored   Include files and directories matching .gitignore patterns (default: excluded)
    -h, --help            Show this help message

Arguments:
    DIRECTORY             Directory to analyze (default: current directory)

Examples:
    summarize-directory-size
    summarize-directory-size /path/to/dir
    summarize-directory-size --threshold-percent 30 /path/to/dir
    summarize-directory-size --max-entries 5 /path/to/dir
    summarize-directory-size --max-entries 0 --max-extensions 0 /path/to/dir

The tool will recursively expand subdirectories that are >= threshold percentage of their parent.
EOF
    exit 0;
}

# Parse options and arguments
while (@ARGV) {
    my $arg = shift @ARGV;

    if ($arg eq '--help' || $arg eq '-h') {
        show_help();
    } elsif ($arg eq '--threshold-percent') {
        die "Error: --threshold-percent requires a value\n" unless @ARGV;
        $threshold_percent = shift @ARGV;
    } elsif ($arg eq '--max-entries') {
        die "Error: --max-entries requires a value\n" unless @ARGV;
        $max_entries = shift @ARGV;
    } elsif ($arg eq '--max-extensions') {
        die "Error: --max-extensions requires a value\n" unless @ARGV;
        $max_extensions = shift @ARGV;
    } elsif ($arg eq '--include-gitignored') {
        $respect_gitignore = 0;
    } elsif ($arg =~ /^--/) {
        die "Error: Unknown option '$arg'\n";
    } else {
        # It's a positional argument (directory)
        $target_dir = $arg;
        $target_dir =~ s/\/$//;  # Remove trailing slash
    }
}

$target_dir ||= '.';

die "Error: Directory '$target_dir' does not exist\n" unless -d $target_dir;
die "Error: Threshold must be a number between 0 and 100\n"
    unless $threshold_percent =~ /^\d+$/ && $threshold_percent >= 0 && $threshold_percent <= 100;
die "Error: --max-entries must be a non-negative integer\n"
    unless $max_entries =~ /^\d+$/;
die "Error: --max-extensions must be a non-negative integer\n"
    unless $max_extensions =~ /^\d+$/;

# Parse .gitignore file and return array of patterns
sub parse_gitignore {
    my ($gitignore_path) = @_;

    return () unless -f $gitignore_path;

    open(my $fh, '<', $gitignore_path) or return ();
    my @patterns;

    while (my $line = <$fh>) {
        chomp $line;
        $line =~ s/^\s+|\s+$//g;  # Trim whitespace

        # Skip empty lines and comments
        next if $line eq '' || $line =~ /^#/;

        push @patterns, $line;
    }

    close($fh);
    return @patterns;
}

# Convert gitignore pattern to regex
sub gitignore_to_regex {
    my ($pattern) = @_;

    my $is_dir_only = ($pattern =~ s/\/$//) ? 1 : 0;
    my $is_negation = ($pattern =~ s/^!//) ? 1 : 0;
    my $is_anchored = ($pattern =~ /^\//) ? 1 : 0;
    $pattern =~ s/^\///;  # Remove leading slash

    # Escape special regex characters except * and ?
    $pattern =~ s/([.+\[\](){}^$|\\])/\\$1/g;

    # Convert gitignore wildcards to regex
    $pattern =~ s/\*\*/DOUBLE_STAR/g;
    $pattern =~ s/\*/[^\/]*/g;
    $pattern =~ s/DOUBLE_STAR/.*/g;
    $pattern =~ s/\?/./g;

    return {
        regex => qr/^$pattern$/,
        is_dir_only => $is_dir_only,
        is_negation => $is_negation,
        is_anchored => $is_anchored,
        original => $pattern
    };
}

# Check if a path matches gitignore patterns
sub is_gitignored {
    my ($path, $is_dir) = @_;

    return 0 unless $respect_gitignore;

    # Get relative path from target directory
    my $rel_path = $path;
    $rel_path =~ s/^\Q$target_dir\E\/?//;

    return 0 if $rel_path eq '';  # Don't ignore the root directory itself

    # Check all gitignore files in the path hierarchy
    my @path_parts = split('/', $rel_path);
    my $current_path = $target_dir;
    my $ignored = 0;

    for (my $i = 0; $i <= @path_parts; $i++) {
        my $gitignore_path = "$current_path/.gitignore";

        if (!exists $gitignore_cache{$gitignore_path}) {
            my @patterns = parse_gitignore($gitignore_path);
            $gitignore_cache{$gitignore_path} = [map { gitignore_to_regex($_) } @patterns];
        }

        my @patterns = @{$gitignore_cache{$gitignore_path}};

        # Get the remaining path relative to this gitignore location
        my $check_path = join('/', @path_parts[$i..$#path_parts]);
        next if $check_path eq '';

        foreach my $pattern (@patterns) {
            next if $pattern->{is_dir_only} && !$is_dir;

            my $matched = 0;
            if ($pattern->{is_anchored}) {
                # Pattern with leading slash matches from directory root
                $matched = ($check_path =~ $pattern->{regex});
            } else {
                # Pattern without leading slash can match anywhere in path
                $matched = ($check_path =~ $pattern->{regex});
                unless ($matched) {
                    # Also try matching against basename
                    my $basename = $path_parts[-1] // '';
                    $matched = ($basename =~ $pattern->{regex});
                }
            }

            if ($matched) {
                $ignored = $pattern->{is_negation} ? 0 : 1;
            }
        }

        last if $i >= @path_parts;
        $current_path .= "/$path_parts[$i]";
    }

    return $ignored;
}

# Format size in human-readable format with right alignment
sub format_size {
    my ($bytes) = @_;

    my ($value, $unit);

    if ($bytes < 1024) {
        $value = $bytes;
        $unit = "B";
    } elsif ($bytes < 1024*1024) {
        $value = $bytes / 1024;
        $unit = "KB";
    } elsif ($bytes < 1024*1024*1024) {
        $value = $bytes / (1024*1024);
        $unit = "MB";
    } else {
        $value = $bytes / (1024*1024*1024);
        $unit = "GB";
    }

    # Format with appropriate precision and width for alignment
    if ($value >= 100) {
        return sprintf("%3.0f %-2s", $value, $unit);
    } elsif ($value >= 10) {
        return sprintf("%4.1f %-2s", $value, $unit);
    } else {
        return sprintf("%5.2f %-2s", $value, $unit);
    }
}

# Scan directory tree and collect size information
sub scan_directory {
    my ($dir) = @_;

    my %local_entries;
    my %local_extensions;
    my $total_size = 0;
    my $total_files = 0;

    # Read directory entries
    opendir(my $dh, $dir) or do {
        warn "Cannot open directory $dir: $!\n";
        return (0, 0, {}, {});
    };

    my @entries = grep { $_ ne '.' && $_ ne '..' } readdir($dh);
    closedir($dh);

    foreach my $entry (@entries) {
        my $full_path = "$dir/$entry";

        # Use lstat to avoid following symlinks
        my @stat = lstat($full_path);
        unless (@stat) {
            warn "Cannot stat $full_path: $!\n";
            next;
        }

        my $is_directory = (-d _);

        # Check if this entry should be ignored
        if (is_gitignored($full_path, $is_directory)) {
            next;
        }

        # Skip .git directory when gitignore is enabled
        if ($respect_gitignore && $entry eq '.git' && $is_directory) {
            next;
        }

        if ($is_directory) {
            # It's a directory - recurse
            my ($subdir_size, $subdir_files, $subdir_entries, $subdir_exts) =
                scan_directory($full_path);

            $local_entries{$entry} = {
                size => $subdir_size,
                count => $subdir_files,
                is_dir => 1,
                path => $full_path
            };

            $total_size += $subdir_size;
            $total_files += $subdir_files;

            # Aggregate extension data
            foreach my $ext (keys %$subdir_exts) {
                $local_extensions{$ext}{size} += $subdir_exts->{$ext}{size};
                $local_extensions{$ext}{count} += $subdir_exts->{$ext}{count};
            }
        } else {
            # It's a file
            my $size = $stat[7];

            $local_entries{$entry} = {
                size => $size,
                is_dir => 0,
                path => $full_path
            };

            $total_size += $size;
            $total_files++;

            # Track extension
            my ($name, $path, $ext) = fileparse($entry, qr/\.[^.]*/);
            if ($ext) {
                $local_extensions{$ext}{size} += $size;
                $local_extensions{$ext}{count}++;
            }
        }
    }

    # Store in global hash
    $dir_data{$dir} = {
        total_size => $total_size,
        file_count => $total_files,
        entries => \%local_entries,
        extensions => \%local_extensions
    };

    return ($total_size, $total_files, \%local_entries, \%local_extensions);
}

# Identify directories to display based on threshold
sub identify_large_dirs {
    my ($dir, $parent_size) = @_;

    my @result = ($dir);  # Always include this directory

    my $data = $dir_data{$dir};
    return @result unless $data;

    my $threshold = $parent_size * ($threshold_percent / 100);

    # Check each subdirectory, sorted by size descending
    foreach my $entry (sort { $data->{entries}{$b}{size} <=> $data->{entries}{$a}{size} } keys %{$data->{entries}}) {
        my $entry_data = $data->{entries}{$entry};

        if ($entry_data->{is_dir} && $entry_data->{size} >= $threshold) {
            # This subdirectory is large enough - recurse
            my @subdirs = identify_large_dirs($entry_data->{path}, $data->{total_size});
            push @result, @subdirs;
        }
    }

    return @result;
}

sub format_directory_output {
    my ($dir) = @_;

    my $data = $dir_data{$dir};
    return unless $data;

    # Print header with original path format
    print "$dir/\n";

    # Print total
    my $size_str = format_size($data->{total_size});
    printf("    Total: %s  %d files\n", $size_str, $data->{file_count});

    # Print entries section
    print "    Entries:\n";

    # Sort entries by size (largest first)
    my @sorted_entries = sort {
        $data->{entries}{$b}{size} <=> $data->{entries}{$a}{size}
    } keys %{$data->{entries}};

    # Apply limit
    my $entries_to_show = $max_entries > 0 ? $max_entries : scalar(@sorted_entries);
    $entries_to_show = scalar(@sorted_entries) if $entries_to_show > scalar(@sorted_entries);

    my $total_entries = scalar(@sorted_entries);
    my $is_truncated = ($max_entries > 0 && $total_entries > $max_entries);

    my $max_full_path_length = 0;
    for (my $i = 0; $i < $entries_to_show; $i++) {
        my $entry = $sorted_entries[$i];
        my $entry_data = $data->{entries}{$entry};
        my $full_path = $entry_data->{path};
        my $length = length($full_path) + ($entry_data->{is_dir} ? 1 : 0);
        $max_full_path_length = $length if $length > $max_full_path_length;
    }

    for (my $i = 0; $i < $entries_to_show; $i++) {
        my $entry = $sorted_entries[$i];
        my $entry_data = $data->{entries}{$entry};
        my $full_path = $entry_data->{path};
        my $size = format_size($entry_data->{size});

        if ($entry_data->{is_dir}) {
            printf("        %-*s %10s  %d files\n",
                   $max_full_path_length, "$full_path/", $size, $entry_data->{count});
        } else {
            printf("        %-*s %10s\n",
                    $max_full_path_length, $full_path, $size);
        }
    }

    if ($is_truncated) {
        printf("        %-50s\n", "...");
    }

    # Print extensions section
    if (keys %{$data->{extensions}}) {
        print "    Extensions:\n";

        # Sort extensions by size (largest first)
        my @sorted_exts = sort {
            $data->{extensions}{$b}{size} <=> $data->{extensions}{$a}{size}
        } keys %{$data->{extensions}};

        # Apply limit
        my $exts_to_show = $max_extensions > 0 ? $max_extensions : scalar(@sorted_exts);
        $exts_to_show = scalar(@sorted_exts) if $exts_to_show > scalar(@sorted_exts);

        my $total_exts = scalar(@sorted_exts);
        my $is_ext_truncated = ($max_extensions > 0 && $total_exts > $max_extensions);

        for (my $i = 0; $i < $exts_to_show; $i++) {
            my $ext = $sorted_exts[$i];
            my $ext_data = $data->{extensions}{$ext};
            my $size = format_size($ext_data->{size});
            printf("        %-20s %10s  %d files\n",
                   $ext, $size, $ext_data->{count});
        }

        if ($is_ext_truncated) {
            printf("        %-20s\n", "...");
        }
    }
}

# Main execution
scan_directory($target_dir);

my @dirs_to_display = identify_large_dirs($target_dir, $dir_data{$target_dir}{total_size});

# Output results
foreach my $dir (@dirs_to_display) {
    format_directory_output($dir);
    print "\n";  # Blank line between directories
}
